+        assertSame(second, queue.poll());
+    }
+
+    @Test
+    public void testAddNullEventFails() {
+        BackgroundEventHandler handler = new BackgroundEventHandler(new LogContext(), new LinkedBlockingQueue<>());
+
+        assertThrows(NullPointerException.class, () -> handler.add(null));
+    }
+}
