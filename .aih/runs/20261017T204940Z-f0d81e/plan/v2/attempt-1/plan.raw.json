{
  "criteria": [
    {
      "intent": "INTENT1",
      "key": "C1",
      "kind": "behavior",
      "text": "cordoned.log.dirs can be set dynamically per broker; values not in log.dirs (and not '*') are rejected; removing the entry uncordons."
    },
    {
      "intent": "INTENT2",
      "key": "C2",
      "kind": "behavior",
      "text": "Below 4.3-IV0, dynamic setting is rejected with a configuration error and static setting has no effect."
    },
    {
      "intent": "INTENT3",
      "key": "C3",
      "kind": "behavior",
      "text": "Heartbeats carry cordoned dirs after catch-up; controller reflects dynamic changes without restart."
    },
    {
      "intent": "INTENT4",
      "key": "C4",
      "kind": "behavior",
      "text": "Auto-placed creation avoids fully cordoned brokers and fails with INVALID_REPLICATION_FACTOR when too few remain."
    },
    {
      "intent": "INTENT5",
      "key": "C5",
      "kind": "behavior",
      "text": "Explicit assignment onto a fully cordoned broker returns INVALID_REPLICA_ASSIGNMENT."
    },
    {
      "intent": "INTENT6",
      "key": "C6",
      "kind": "behavior",
      "text": "Reassignment onto a fully cordoned broker returns INELIGIBLE_REPLICA."
    },
    {
      "intent": "INTENT7",
      "key": "C7",
      "kind": "behavior",
      "text": "AlterReplicaLogDirs to a cordoned directory returns INVALID_REPLICA_ASSIGNMENT."
    },
    {
      "intent": "INTENT8",
      "key": "C8",
      "kind": "behavior",
      "text": "Broker never creates a new replica in a cordoned directory even if the controller suggested it."
    },
    {
      "intent": "INTENT9",
      "key": "C9",
      "kind": "behavior",
      "text": "DescribeLogDirs returns per-directory cordoned state via LogDirDescription.isCordoned() and the tool prints it."
    },
    {
      "intent": "INTENT10",
      "key": "C10",
      "kind": "behavior",
      "text": "LogDirectoryCordoned and CordonedLogDirectoryCount metrics are registered and accurate."
    },
    {
      "intent": "INTENT11",
      "key": "C11",
      "kind": "behavior",
      "text": "Integration test cordons/uncordons via Admin on an embedded cluster and checks placement and errors."
    }
  ],
